# Copy to .env.local and fill in real values. Never commit .env.local.

# PostgreSQL connection string.
# In production (Supabase) prefer the transaction pooler on port 6543.
DATABASE_URL=postgresql://user:password@host:5432/gym_erp

# Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Public base URL used by the browser client
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend transactional email
RESEND_API_KEY=re_replace_me
# Must be an address on a domain verified in Resend.
# onboarding@resend.dev is Resend's test sender and only delivers to the
# Resend account owner's address.
EMAIL_FROM=Gym ERP <no-reply@your-domain.com>

# Optional: Google OAuth (required together to enable sign-up and login with Google)
# Authorized redirect URI in Google Cloud Console:
#   http://localhost:3000/api/auth/callback/google
# Use the same path on your public origin in production.
# GOOGLE_CLIENT_ID=replace-with-google-client-id
# GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Optional: password for the development seed accounts (defaults to a known
# development password when unset). Only used by `npm run db:seed`.
# SEED_DEFAULT_PASSWORD=replace-me
